disturl="https://nodejs.org/dist"
target="24.18.0"
ms_build_id=""
runtime="node"
# Setting disturl makes node-gyp read the downloaded headers' config.gypi
# instead of the host node's process.config. Those headers are built on
# Linux/gcc and say clang=0, which on macOS silently disables the
# ['clang==1'] block in node's common.gypi that supplies
# CLANG_CXX_LANGUAGE_STANDARD (gnu++20) and CLANG_CXX_LIBRARY (libc++) -
# leaving native addons with no -std= at all. build/.npmrc already sets
# this for the same reason.
force_process_config="true"
ignore-scripts=false
legacy-peer-deps="true"
timeout=180000
