disturl="https://nodejs.org/dist"
target="24.18.1"
ms_build_id="463514"
runtime="node"
# See the note in the root .npmrc: without this, node-gyp reads the
# Linux-built headers' config.gypi (clang=0) and macOS native addons get
# no -std= / -stdlib= flags at all.
force_process_config="true"
legacy-peer-deps="true"
timeout=180000
